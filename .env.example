# --- Application ---
APP_NAME=Noor API
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# --- MongoDB Atlas ---
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB_NAME=noor

# --- Redis ---
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=60

# --- JWT ---
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Firebase (leave blank in dev to use the identity stub) ---
FIREBASE_CREDENTIALS_FILE=
FIREBASE_PROJECT_ID=

# --- CORS ---
CORS_ORIGINS=["*"]

# --- Domain ---
SUBMISSION_UNDO_WINDOW_SECONDS=300
DEFAULT_TIMEZONE=Asia/Karachi
