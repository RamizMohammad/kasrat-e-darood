# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# If your project uses WebView with JS, uncomment the following
# and specify the fully qualified class name to the JavaScript interface
# class:
#-keepclassmembers class fqcn.of.javascript.interface.for.webview {
#   public *;
#}

# --- Kasrat-e-Darood -------------------------------------------------------
# Gson reads and writes these classes by reflection. Keep their names, fields
# and constructors so JSON keeps mapping after R8 renames everything else.
-keep class in.mohammad.ramiz.islamic.kasrat_e_darrod.data.remote.** { *; }
-keep class in.mohammad.ramiz.islamic.kasrat_e_darrod.data.model.** { *; }
-keepattributes Signature, InnerClasses, EnclosingMethod, *Annotation*
-keepclassmembers,allowobfuscation class * {
    @com.google.gson.annotations.SerializedName <fields>;
}
# Retrofit service interfaces (generic return types read at runtime).
-keep,allowobfuscation,allowshrinking interface retrofit2.Call
-keep,allowobfuscation,allowshrinking class retrofit2.Response
-keep,allowobfuscation,allowshrinking class kotlin.coroutines.Continuation

# --- Release hardening -----------------------------------------------------
# Strip debug/info/verbose/warn logging from release builds (nothing about the
# user or the network ends up in logcat). Log.e stays for crash reports.
-assumenosideeffects class android.util.Log {
    public static int v(...);
    public static int d(...);
    public static int i(...);
    public static int w(...);
    public static boolean isLoggable(java.lang.String, int);
}
# Make the security checks harder to find and patch out.
-repackageclasses ''
