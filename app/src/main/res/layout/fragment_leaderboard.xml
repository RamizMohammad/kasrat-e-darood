<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp" android:paddingTop="24dp" android:paddingBottom="24dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/community_standings"
            android:textSize="28sp" android:textStyle="bold" android:fontFamily="sans-serif-medium"
            android:textColor="@color/on_surface" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="@string/leaderboard_subtitle"
            android:textColor="@color/on_surface_variant" android:textSize="14sp" />

        <!-- Awesome top-3 podium -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/lb_podium"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" app:cardCornerRadius="24dp" app:cardElevation="0dp"
            app:cardBackgroundColor="@android:color/transparent"
            android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_emerald_card" android:orientation="vertical"
                android:padding="20dp">

                <TextView style="@style/Text.Overline" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/top_reciters"
                    android:textColor="@color/on_primary_container" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:orientation="horizontal"
                    android:gravity="bottom" android:baselineAligned="false">

                    <!-- 2nd -->
                    <LinearLayout android:id="@+id/lb_p2_col"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="center">
                        <ImageView android:id="@+id/lb_p2_avatar"
                            android:layout_width="56dp" android:layout_height="56dp"
                            android:scaleType="centerCrop" android:src="@drawable/default_profile" />
                        <TextView android:id="@+id/lb_p2_name"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" android:text="" android:textStyle="bold"
                            android:fontFamily="serif" android:textColor="@color/white"
                            android:maxLines="1" android:ellipsize="end" />
                        <TextView android:id="@+id/lb_p2_total"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="" android:textColor="@color/on_primary_container" android:textSize="11sp" />
                    </LinearLayout>

                    <!-- 1st -->
                    <LinearLayout android:id="@+id/lb_p1_col"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="center">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp"
                            android:src="@drawable/ic_trophy" app:tint="@color/gold" />
                        <ImageView android:id="@+id/lb_p1_avatar"
                            android:layout_width="78dp" android:layout_height="78dp"
                            android:layout_marginTop="4dp"
                            android:scaleType="centerCrop" android:src="@drawable/default_profile" />
                        <TextView android:id="@+id/lb_p1_name"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" android:text="" android:textStyle="bold"
                            android:fontFamily="serif" android:textColor="@color/white" android:textSize="16sp"
                            android:maxLines="1" android:ellipsize="end" />
                        <TextView android:id="@+id/lb_p1_total"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="" android:textColor="@color/primary_fixed" android:textSize="12sp" />
                    </LinearLayout>

                    <!-- 3rd -->
                    <LinearLayout android:id="@+id/lb_p3_col"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="center">
                        <ImageView android:id="@+id/lb_p3_avatar"
                            android:layout_width="56dp" android:layout_height="56dp"
                            android:scaleType="centerCrop" android:src="@drawable/default_profile" />
                        <TextView android:id="@+id/lb_p3_name"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" android:text="" android:textStyle="bold"
                            android:fontFamily="serif" android:textColor="@color/white"
                            android:maxLines="1" android:ellipsize="end" />
                        <TextView android:id="@+id/lb_p3_total"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="" android:textColor="@color/on_primary_container" android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- The rest of the standings -->
        <TextView android:id="@+id/lb_rest_header" style="@style/Text.Overline"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:layout_marginStart="4dp"
            android:text="@string/everyone_else" android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_leaderboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:nestedScrollingEnabled="false" />

        <TextView
            android:id="@+id/leaderboard_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingVertical="48dp"
            android:text="@string/empty_leaderboard"
            android:textColor="@color/on_surface_variant"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
