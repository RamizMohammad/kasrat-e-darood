<?xml version="1.0" encoding="utf-8"?>
<!-- Radio card (Stitch new_circle_teal privacy): 40dp icon disc, title-md + body-sm, check-circle
     when chosen; chosen card gets a deep-teal hairline. KChoice fills and marks it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/choice_card"
    style="@style/K.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <FrameLayout
        android:id="@+id/choice_icon_disc"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_k_emblem_soft">

        <ImageView
            android:id="@+id/choice_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:tint="@color/amber" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/choice_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.K.TitleMd"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/choice_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.K.BodySm"
            android:textColor="@color/text_muted" />
    </LinearLayout>

    <ImageView
        android:id="@+id/choice_check"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="12dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_ph_check_circle"
        app:tint="@color/amber" />
</LinearLayout>
