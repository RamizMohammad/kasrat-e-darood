<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="24dp" android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <!-- Header -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/stats_avatar"
                android:layout_width="36dp" android:layout_height="36dp"
                android:scaleType="centerCrop"
                android:src="@drawable/default_profile" />
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:layout_marginStart="12dp" android:text="@string/greeting" android:textSize="18sp"
                android:textStyle="bold" android:fontFamily="serif" android:textColor="@color/primary" />
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@drawable/ic_bell" app:tint="@color/on_surface_variant" />
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="@string/weekly_insights"
            android:textSize="28sp" android:textStyle="bold" android:fontFamily="sans-serif-medium"
            android:textColor="@color/on_surface" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="@string/stats_subtitle"
            android:textColor="@color/on_surface_variant" android:textSize="14sp" />

        <!-- Top widget: total community submissions + embedded category pie -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" app:cardCornerRadius="24dp" app:cardElevation="0dp"
            app:cardBackgroundColor="@android:color/transparent">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_emerald_card" android:orientation="vertical" android:padding="22dp">
                <TextView style="@style/Text.Overline" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/community_standings"
                    android:textColor="@color/on_primary_container" />
                <TextView android:id="@+id/stats_total"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:text="0" android:textSize="44sp"
                    android:textStyle="bold" android:fontFamily="serif" android:textColor="@color/white" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/total_submissions_week"
                    android:textColor="@color/on_primary_container" android:textSize="13sp" />
                <TextView android:id="@+id/stats_week_label"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text=""
                    android:textColor="@color/primary_fixed" android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- File consideration / close week (super member / super admin only) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_close_week"
            style="@style/Widget.Noor.Button"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:text="@string/file_consideration"
            android:visibility="gone"
            app:icon="@drawable/ic_shield" app:iconGravity="textStart" />

        <!-- Breakdown grouped & sorted by category -->
        <TextView style="@style/Text.Overline" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:layout_marginStart="4dp" android:text="@string/by_category" />

        <com.google.android.material.card.MaterialCardView style="@style/Widget.Noor.Card"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" app:contentPadding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/stats_bars"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />
                <TextView android:id="@+id/stats_empty"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center" android:padding="16dp"
                    android:text="@string/no_submissions_week"
                    android:textColor="@color/on_surface_variant" android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
