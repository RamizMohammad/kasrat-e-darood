<?xml version="1.0" encoding="utf-8"?>
<!-- Runner-up in a Hall card: avatar + name / total (featured: 32dp, two lines; older: 24dp,
     "Name · 39,400" on one line). HallOfFameActivity sets the sizes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:gravity="center"
    android:orientation="horizontal">

    <FrameLayout
        android:id="@+id/hp_ring"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_k_avatar_disc"
        android:padding="1dp">

        <in.mohammad.ramiz.islamic.kasrat_e_darrod.ui.components.AuraAvatarView
            android:id="@+id/hp_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/hp_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.K.LabelSm"
            android:textColor="@color/text_primary"
            tools:text="Bilal" />

        <TextView
            android:id="@+id/hp_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.K.SerifLabel"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            tools:text="41,200" />
    </LinearLayout>

    <TextView
        android:id="@+id/hp_rank"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</LinearLayout>
