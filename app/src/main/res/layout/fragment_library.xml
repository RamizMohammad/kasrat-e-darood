<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 4 · Recite (Stitch recite_teal): "Recite" + streak + avatar, search pill,
     category tabs (chosen = deep-ink capsule), recitation cards; a floating log bar
     ("2 recitations · 133" + Log) sits 12dp above the floating bottom bar. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/library_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/library_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/k_page_margin"
            android:paddingTop="32dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/library_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:text="@string/recite_title_k"
                android:textAppearance="@style/TextAppearance.K.HeadlineLgMobile"
                android:textColor="@color/text_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/library_add"
                style="@style/Widget.Kasrat.IconButton.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:contentDescription="@string/recite_add_new"
                android:visibility="gone"
                app:icon="@drawable/ic_ph_plus"
                app:iconTint="@color/text_primary" />

            <TextView
                android:id="@+id/library_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_k_streak"
                android:drawablePadding="6dp"
                android:elevation="3dp"
                android:gravity="center_vertical"
                android:outlineAmbientShadowColor="@color/transparent"
                android:outlineSpotShadowColor="@color/k_shadow_card"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:textAppearance="@style/TextAppearance.K.SerifLabel"
                android:textColor="@color/text_primary"
                android:visibility="gone"
                tools:text="14"
                tools:visibility="visible" />

            <in.mohammad.ramiz.islamic.kasrat_e_darrod.ui.components.AuraAvatarView
                android:id="@+id/library_avatar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_k_emblem_white"
                android:contentDescription="@string/header_profile_cd"
                android:elevation="3dp"
                android:outlineAmbientShadowColor="@color/transparent"
                android:outlineSpotShadowColor="@color/k_shadow_card" />
        </LinearLayout>

        <!-- Search -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/k_page_margin"
            android:background="@drawable/bg_k_search">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ph_magnifying_glass"
                app:tint="@color/text_muted" />

            <EditText
                android:id="@+id/library_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="@string/recite_search_k"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="44dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp"
                android:textAppearance="@style/TextAppearance.K.BodySm"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted" />
        </FrameLayout>

        <!-- Category tabs -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingHorizontal="@dimen/k_page_margin"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/library_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/library_offline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/k_page_margin"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_tag"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="@string/recite_offline_title"
            android:textAppearance="@style/TextAppearance.K.LabelSm"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="20dp"
            android:layout_weight="1">

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/library_refresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/library_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingHorizontal="@dimen/k_page_margin"
                    android:paddingTop="4dp" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <LinearLayout
                android:id="@+id/library_skeleton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/k_page_margin"
                android:visibility="gone">

                <View android:layout_width="match_parent" android:layout_height="180dp" android:background="@drawable/bg_k_card" />
                <View android:layout_width="match_parent" android:layout_height="180dp" android:layout_marginTop="16dp" android:background="@drawable/bg_k_card" />
                <View android:layout_width="match_parent" android:layout_height="180dp" android:layout_marginTop="16dp" android:background="@drawable/bg_k_card" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/library_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/k_page_margin"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/library_state_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.K.HeadlineSm"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/library_state_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.K.BodySm"
                    android:textColor="@color/text_muted" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/library_state_action"
                    style="@style/Widget.Kasrat.Button.Link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Floating log bar -->
    <LinearLayout
        android:id="@+id/cart_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="@dimen/k_page_margin"
        android:background="@drawable/bg_k_nav"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:outlineAmbientShadowColor="@color/transparent"
        android:outlineSpotShadowColor="@color/k_shadow_card"
        android:paddingVertical="8dp"
        android:paddingStart="20dp"
        android:paddingEnd="8dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/cart_bar_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFeatureSettings="tnum"
            android:textAppearance="@style/TextAppearance.K.BodySm"
            android:textColor="@color/text_primary"
            tools:text="2 recitations · 133" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cart_bar_log"
            style="@style/Widget.K.Button.Hero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:elevation="6dp"
            android:minWidth="0dp"
            android:minHeight="36dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="0dp"
            android:text="@string/cart_bar_log" />
    </LinearLayout>
</FrameLayout>
