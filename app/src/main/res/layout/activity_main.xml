<?xml version="1.0" encoding="utf-8"?>
<!-- Shell (Stitch): the tab fragment fills the screen and the bottom bar floats over it.
     Each tab draws its own header and pads itself clear of the bar (MainActivity.NavSpaceAware). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink">

    <FrameLayout
        android:id="@+id/nav_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false" />

    <include
        android:id="@+id/bottom_bar"
        layout="@layout/view_bottom_bar" />
</FrameLayout>
