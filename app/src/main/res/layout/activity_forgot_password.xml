<?xml version="1.0" encoding="utf-8"?>
<!-- P1 · Forgot password: one screen, three steps (email → 6-digit code → new password). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink">

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:indeterminate="true"
        android:visibility="invisible"
        app:trackColor="@color/transparent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/column"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/k_page_margin"
            android:paddingTop="@dimen/space_lg"
            android:paddingBottom="@dimen/space_lg">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_back"
                style="@style/Widget.Kasrat.IconButton.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/action_back"
                app:icon="@drawable/ic_ph_arrow_left"
                app:iconTint="@color/text_primary" />

            <TextView
                android:id="@+id/step_tag"
                style="@style/Kasrat.Tag.Paper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:drawableStart="@drawable/dot_k_teal" />

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:textAppearance="@style/TextAppearance.Kasrat.Headline" />

            <TextView
                android:id="@+id/sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:textAppearance="@style/TextAppearance.Kasrat.Body"
                android:textColor="@color/text_secondary" />

            <!-- Step 1: email -->
            <LinearLayout
                android:id="@+id/step_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:orientation="vertical">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/input_email_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:placeholderText="@string/hint_email_address">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_email_address"
                        android:imeOptions="actionDone"
                        android:inputType="textEmailAddress"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Step 2: 6-digit code (one hidden input drives six tiles) -->
            <LinearLayout
                android:id="@+id/step_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:orientation="vertical"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layoutDirection="ltr">

                    <LinearLayout
                        android:id="@+id/otp_boxes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="noHideDescendants"
                        android:orientation="horizontal">
                    <TextView
                        android:id="@+id/otp_0"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/k_code_box"
                        android:layout_weight="1"
                        
                        android:background="@drawable/bg_otp_box"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.K.SerifTitle"
                        android:textColor="@color/text_primary" />
                    <TextView
                        android:id="@+id/otp_1"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/k_code_box"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_otp_box"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.K.SerifTitle"
                        android:textColor="@color/text_primary" />
                    <TextView
                        android:id="@+id/otp_2"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/k_code_box"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_otp_box"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.K.SerifTitle"
                        android:textColor="@color/text_primary" />
                    <TextView
                        android:id="@+id/otp_3"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/k_code_box"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_otp_box"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.K.SerifTitle"
                        android:textColor="@color/text_primary" />
                    <TextView
                        android:id="@+id/otp_4"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/k_code_box"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_otp_box"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.K.SerifTitle"
                        android:textColor="@color/text_primary" />
                    <TextView
                        android:id="@+id/otp_5"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/k_code_box"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_otp_box"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.K.SerifTitle"
                        android:textColor="@color/text_primary" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/otp_input"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:alpha="0.01"
                        android:autofillHints="smsOTPCode"
                        android:background="@null"
                        android:contentDescription="@string/err_code_required"
                        android:cursorVisible="false"
                        android:importantForAutofill="yes"
                        android:inputType="number"
                        android:maxLength="6"
                        android:textColor="@color/transparent" />
                </FrameLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_resend"
                    style="@style/Widget.Kasrat.Button.Ghost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:layout_marginStart="-12dp"
                    android:text="@string/fp_resend" />
            </LinearLayout>

            <!-- Step 3: new password -->
            <LinearLayout
                android:id="@+id/step_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/input_password_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/text_secondary"
                    app:placeholderText="@string/hint_new_password">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_new_password"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:id="@+id/strength_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="invisible">

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/strength_bar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="3"
                        app:trackCornerRadius="2dp"
                        app:trackThickness="4dp" />

                    <TextView
                        android:id="@+id/strength_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:minWidth="64dp"
                        android:textAlignment="viewEnd"
                        android:textAppearance="@style/TextAppearance.Kasrat.MetaSmall" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_error_plate"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingVertical="@dimen/space_12"
                android:textAppearance="@style/TextAppearance.Kasrat.BodyMedium"
                android:textColor="@color/brick"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="@dimen/space_lg" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_primary"
                style="@style/Widget.K.Button.Hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
