<?xml version="1.0" encoding="utf-8"?>
<!-- Circle card (Stitch circles_teal): 48dp emblem, Fraunces name, role (or a gold "Goal
     reached" pill), "14 members · You 1,240", then "Weekly goal … 84,250 / 1,00,000" and a
     6dp bar. A circle that reached its goal gets a gold hairline. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="16dp">

    <LinearLayout
        android:id="@+id/gr_card"
        style="@style/K.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:foreground="?attr/selectableItemBackground"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <in.mohammad.ramiz.islamic.kasrat_e_darrod.ui.components.GroupAvatarView
                android:id="@+id/gr_avatar"
                android:layout_width="48dp"
                android:layout_height="48dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/gr_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.K.HeadlineSm"
                        android:textColor="@color/text_primary"
                        tools:text="Karachi &amp; Lahore Family" />

                    <TextView
                        android:id="@+id/gr_privacy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textAppearance="@style/TextAppearance.K.LabelSm"
                        android:textColor="@color/text_muted"
                        tools:text="Admin" />
                </LinearLayout>

                <TextView
                    android:id="@+id/gr_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFeatureSettings="tnum"
                    android:textAppearance="@style/TextAppearance.K.BodySm"
                    android:textColor="@color/text_muted"
                    tools:text="14 members · You 1,240" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/gr_goal_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/gr_goal_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/groups_goal_row"
                    android:textAppearance="@style/TextAppearance.K.LabelSm"
                    android:textColor="@color/text_muted" />

                <TextView
                    android:id="@+id/gr_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.K.SerifLabel"
                    android:textColor="@color/text_primary"
                    tools:text="84,250 / 1,00,000" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/gr_goal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:max="1000" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
