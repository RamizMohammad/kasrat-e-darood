<?xml version="1.0" encoding="utf-8"?>
<!-- Settings switch row (Stitch settings_teal): label (+ sub), 44 × 24 teal switch. The whole
     row toggles; the switch itself isn't clickable. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/switch_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.K.BodyMd"
            android:textColor="@color/text_primary"
            tools:text="Show me on global ranks" />

        <TextView
            android:id="@+id/switch_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.K.BodySm"
            android:textColor="@color/text_muted"
            android:visibility="gone"
            tools:text="Display your name on ummah leaderboards"
            tools:visibility="visible" />
    </LinearLayout>

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switch_toggle"
        android:saveEnabled="false"
        style="@style/Widget.Kasrat.Switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no" />
</LinearLayout>
