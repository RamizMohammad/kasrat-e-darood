<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="18dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/surface_container_lowest"
    app:contentPadding="16dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">

        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/week_title"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Week 1" android:textColor="@color/on_surface"
                android:textSize="16sp" android:textStyle="bold" android:fontFamily="serif" />
            <TextView android:id="@+id/week_meta"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:text=""
                android:textColor="@color/on_surface_variant" android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="end"
            android:layout_marginEnd="12dp">
            <TextView android:id="@+id/week_total"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0" android:textColor="@color/primary" android:textStyle="bold"
                android:fontFamily="serif" android:textSize="18sp" />
            <TextView style="@style/Text.Overline" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/total_submissions_overline" />
        </LinearLayout>

        <FrameLayout android:layout_width="44dp" android:layout_height="44dp"
            android:background="@drawable/bg_icon_chip">
            <ImageView android:layout_width="22dp" android:layout_height="22dp"
                android:layout_gravity="center" android:src="@drawable/ic_book_open"
                app:tint="@color/primary" />
        </FrameLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
