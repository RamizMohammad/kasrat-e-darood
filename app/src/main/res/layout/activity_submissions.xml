<?xml version="1.0" encoding="utf-8"?>
<!--
    Phase 7a · History (Stitch history_teal): back, "History" with a month picker (‹ November
    2026 ›), "This month · 18,240 · 26 active days", then each day's logs in one hairline card
    under "TODAY · 333 darood". A log can be undone for 5 minutes from its row.
    Driven by ui/profile/SubmissionsActivity.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/subs_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/k_page_margin"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back"
            style="@style/Widget.Kasrat.IconButton.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/action_back"
            app:icon="@drawable/ic_ph_arrow_left"
            app:iconTint="@color/text_primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:text="@string/me_k_history"
                android:textAppearance="@style/TextAppearance.K.HeadlineLgMobile"
                android:textColor="@color/text_primary" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_k_pill_paper"
                android:elevation="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:outlineAmbientShadowColor="@color/transparent"
                android:outlineSpotShadowColor="@color/k_shadow_card"
                android:paddingHorizontal="4dp"
                android:paddingVertical="2dp">

                <ImageButton
                    android:id="@+id/subs_prev"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/history_prev_month"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_ph_caret_left"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/subs_month"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="4dp"
                    android:textAppearance="@style/TextAppearance.K.LabelSm"
                    android:textColor="@color/text_primary"
                    tools:text="November 2026" />

                <ImageButton
                    android:id="@+id/subs_next"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/history_next_month"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_ph_caret_right"
                    app:tint="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_k_summary_box"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:outlineAmbientShadowColor="@color/transparent"
            android:outlineSpotShadowColor="@color/k_shadow_card"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <TextView
                android:id="@+id/subs_summary_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/history_this_month"
                android:textAppearance="@style/TextAppearance.K.BodySm"
                android:textColor="@color/text_muted" />

            <TextView
                android:id="@+id/subs_summary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFeatureSettings="tnum"
                android:gravity="end"
                android:text="—"
                android:textAlignment="viewEnd"
                android:textAppearance="@style/TextAppearance.K.LabelLg"
                android:textColor="@color/text_primary"
                tools:text="18,240 · 26 active days" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/subs_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/subs_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/k_page_margin"
                android:paddingTop="8dp"
                android:paddingBottom="40dp" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <LinearLayout
            android:id="@+id/subs_skeleton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/k_page_margin"
            android:paddingTop="8dp"
            android:visibility="gone">

            <View android:layout_width="96dp" android:layout_height="12dp" android:background="@drawable/bg_k_skeleton_line" />
            <View android:layout_width="match_parent" android:layout_height="144dp" android:layout_marginTop="12dp" android:background="@drawable/bg_k_skeleton_line" />
            <View android:layout_width="96dp" android:layout_height="12dp" android:layout_marginTop="24dp" android:background="@drawable/bg_k_skeleton_line" />
            <View android:layout_width="match_parent" android:layout_height="216dp" android:layout_marginTop="12dp" android:background="@drawable/bg_k_skeleton_line" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/subs_state"
            style="@style/K.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/k_page_margin"
            android:layout_marginTop="8dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ph_clock_counter_clockwise"
                app:tint="@color/amber" />

            <TextView
                android:id="@+id/subs_state_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.K.HeadlineSm"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/subs_state_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.K.BodySm"
                android:textColor="@color/text_muted" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/subs_state_action"
                style="@style/Widget.K.Button.Paper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
