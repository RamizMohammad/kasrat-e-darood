<?xml version="1.0" encoding="utf-8"?>
<!-- Me menu row (Stitch me_teal): 20dp warm-grey icon, label, caret. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingHorizontal="20dp"
    android:paddingVertical="16dp">

    <ImageView
        android:id="@+id/row_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        app:tint="@color/text_muted" />

    <TextView
        android:id="@+id/row_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.K.BodyMd"
        android:textColor="@color/text_primary"
        tools:text="History" />

    <TextView
        android:id="@+id/row_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:fontFeatureSettings="tnum"
        android:textAppearance="@style/TextAppearance.K.LabelSm"
        android:textColor="@color/amber"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/row_caret"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_ph_caret_right"
        app:tint="@color/text_muted" />
</LinearLayout>
