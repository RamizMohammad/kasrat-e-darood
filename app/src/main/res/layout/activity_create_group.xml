<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 6 · New circle (Stitch new_circle_teal), one page: emblem builder, name +
     description, weekly goal (25k · 50k · 1 lakh · None; tap the number for any amount),
     Private / Public, and a sticky "Create circle". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/k_page_margin"
        android:paddingTop="32dp"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back"
            style="@style/Widget.Kasrat.IconButton.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/action_back"
            android:elevation="3dp"
            app:icon="@drawable/ic_ph_arrow_left"
            app:iconTint="@color/text_primary" />

        <TextView
            android:id="@+id/toolbar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:accessibilityHeading="true"
            android:text="@string/circles_new_title"
            android:textAppearance="@style/TextAppearance.K.HeadlineLgMobile"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/k_page_margin"
            android:paddingBottom="32dp">

            <!-- Emblem -->
            <in.mohammad.ramiz.islamic.kasrat_e_darrod.ui.groups.GroupAvatarPicker
                android:id="@+id/create_avatar"
                style="@style/K.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp" />

            <!-- Name + description -->
            <LinearLayout
                style="@style/K.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:labelFor="@id/create_name"
                    android:text="@string/circles_name_label"
                    android:textAppearance="@style/TextAppearance.K.LabelSm"
                    android:textColor="@color/text_primary" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/create_name_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/create_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/circles_name_hint"
                        android:imeOptions="actionNext"
                        android:inputType="textCapWords"
                        android:maxLength="40"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/create_desc_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="6dp"
                    android:labelFor="@id/create_desc"
                    android:textAppearance="@style/TextAppearance.K.LabelSm"
                    android:textColor="@color/text_primary" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/create_desc_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/create_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/circles_desc_hint"
                        android:imeOptions="actionDone"
                        android:inputType="textCapSentences"
                        android:maxLength="140"
                        android:maxLines="2" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Weekly goal -->
            <LinearLayout
                style="@style/K.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/groups_goal_row"
                        android:textAppearance="@style/TextAppearance.K.TitleMd"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/create_goal_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:textAppearance="@style/TextAppearance.K.DisplayLgMobile"
                        android:textColor="@color/text_primary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/create_goal_chips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal" />

                <TextView
                    android:id="@+id/create_goal_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/circles_goal_resets"
                    android:textAppearance="@style/TextAppearance.K.LabelSm"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <!-- Privacy -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/groups_privacy_label"
                android:textAppearance="@style/TextAppearance.K.TitleMd"
                android:textColor="@color/text_primary" />

            <include
                android:id="@+id/create_private"
                layout="@layout/item_k_choice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <include
                android:id="@+id/create_public"
                layout="@layout/item_k_choice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/create_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_error_plate"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:textAppearance="@style/TextAppearance.K.BodySm"
                android:textColor="@color/brick"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/create_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_k_footer_bar"
        android:paddingHorizontal="@dimen/k_page_margin"
        android:paddingVertical="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/create_next"
            style="@style/Widget.K.Button.Hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/circles_create_button" />
    </FrameLayout>
</LinearLayout>
