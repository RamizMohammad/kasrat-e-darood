<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    app:cardCornerRadius="22dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/surface_container_lowest"
    app:contentPadding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_chip">
                <ImageView
                    android:id="@+id/cat_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_book_open"
                    app:tint="@color/primary" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/cat_urdu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="سورۃ یٰسین"
                    android:textSize="22sp"
                    android:textColor="@color/on_surface"
                    android:fontFamily="serif"
                    android:textDirection="rtl"
                    android:gravity="start" />

                <TextView
                    android:id="@+id/cat_english"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Surah Ya-Sin"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    android:textColor="@color/on_surface" />

                <TextView
                    android:id="@+id/cat_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Heart of the Quran · Quran 36"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface_variant" />
            </LinearLayout>
        </LinearLayout>

        <!-- Quantity stepper -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cat_recited_label"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/times_recited"
                android:textSize="12sp"
                android:textColor="@color/on_surface_variant" />

            <TextView
                android:id="@+id/btn_minus"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:gravity="center"
                android:text="−"
                android:textSize="22sp"
                android:textColor="@color/primary"
                android:background="@drawable/bg_pill_outline"
                android:contentDescription="@string/decrease" />

            <TextView
                android:id="@+id/cat_count"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="0"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/on_surface" />

            <TextView
                android:id="@+id/btn_plus"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:gravity="center"
                android:text="+"
                android:textSize="20sp"
                android:textColor="@color/on_primary"
                android:background="@drawable/bg_pill_primary"
                android:contentDescription="@string/increase" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
