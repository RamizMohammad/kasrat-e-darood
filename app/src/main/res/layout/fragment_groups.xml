<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 6 · Circles (Stitch circles_teal / circles_empty_teal): "Circles" + "Join with code"
     + create (+), then the week summary and your circle cards; with no circles, the
     empty state. The list pads itself clear of the floating bottom bar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/groups_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/k_page_margin"
        android:paddingTop="32dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:text="@string/tab_circles"
            android:textAppearance="@style/TextAppearance.K.HeadlineLgMobile"
            android:textColor="@color/text_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/groups_join"
            style="@style/Widget.K.Button.Quiet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="36dp"
            android:paddingHorizontal="8dp"
            android:text="@string/groups_join_code"
            android:textAppearance="@style/TextAppearance.K.LabelSm"
            android:textColor="@color/text_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/groups_fab"
            style="@style/Widget.Kasrat.IconButton.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:contentDescription="@string/circles_create"
            android:elevation="3dp"
            app:icon="@drawable/ic_ph_plus"
            app:iconTint="@color/text_primary" />
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/groups_refresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/groups_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/k_page_margin"
            android:paddingTop="4dp" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
