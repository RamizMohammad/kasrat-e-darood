<?xml version="1.0" encoding="utf-8"?>
<!-- Newest closed week (Stitch hall_of_fame_teal hero): 2dp gold-gradient frame, eyebrow,
     80dp gold-ringed winner with a laurel badge, name + Fraunces total, hairline, #2 · #3. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_k_gold_frame"
        android:elevation="10dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:outlineAmbientShadowColor="@color/transparent"
        android:outlineSpotShadowColor="@color/k_shadow_card"
        android:padding="26dp">

        <TextView
            android:id="@+id/hall_week"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.K.Eyebrow"
            android:textColor="@color/text_muted"
            tools:text="WEEK 47 · 15–21 NOV" />

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:clipChildren="false"
            android:paddingBottom="12dp">

            <FrameLayout
                android:id="@+id/hall_winner_ring"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/ring_k_gold"
                android:padding="4dp">

                <in.mohammad.ramiz.islamic.kasrat_e_darrod.ui.components.AuraAvatarView
                    android:id="@+id/hall_winner_avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="bottom|center_horizontal"
                android:background="@drawable/bg_k_badge_gold">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_k_laurel_stem" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/hall_winner_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.K.HeadlineSm"
            android:textColor="@color/text_primary"
            tools:text="Ayesha Siddiqui" />

        <TextView
            android:id="@+id/hall_winner_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.K.DisplayLgMobile"
            android:textColor="@color/text_primary"
            tools:text="48,620" />

        <TextView
            android:id="@+id/hall_nobody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/hall_nobody"
            android:textAppearance="@style/TextAppearance.K.BodySm"
            android:textColor="@color/text_muted"
            android:visibility="gone" />

        <View
            android:id="@+id/hall_rule"
            android:layout_width="match_parent"
            android:layout_height="@dimen/hairline"
            android:layout_marginTop="20dp"
            android:background="@color/hairline" />

        <LinearLayout
            android:id="@+id/hall_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal" />
    </LinearLayout>
</FrameLayout>
