<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="10dp">
    <TextView android:id="@+id/prayer_name"
        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:text="Fajr" android:textColor="@color/on_surface" android:textSize="15sp" />
    <TextView android:id="@+id/prayer_time"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="04:42" android:textColor="@color/on_surface_variant" android:textSize="15sp"
        android:fontFamily="sans-serif-medium" />
</LinearLayout>
