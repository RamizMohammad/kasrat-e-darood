<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingHorizontal="20dp" android:paddingTop="50dp" android:paddingBottom="4dp">
        <TextView android:id="@+id/btn_back"
            android:layout_width="40dp" android:layout_height="40dp"
            android:gravity="center" android:text="‹" android:textSize="28sp"
            android:textColor="@color/on_surface" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:text="@string/week_report"
            android:textSize="22sp" android:textStyle="bold"
            android:fontFamily="serif" android:textColor="@color/primary" />
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingHorizontal="24dp" android:paddingBottom="8dp"
        android:text="@string/week_report_subtitle"
        android:textColor="@color/on_surface_variant" android:textSize="14sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_weeks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="24dp"
        android:paddingBottom="20dp" />

    <TextView
        android:id="@+id/weeks_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/no_archived_weeks"
        android:textColor="@color/on_surface_variant"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/weeks_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"
        android:visibility="gone" />
</LinearLayout>
