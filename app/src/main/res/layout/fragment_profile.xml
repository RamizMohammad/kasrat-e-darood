<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_horizontal"
        android:paddingHorizontal="24dp" android:paddingTop="40dp">

        <View android:layout_width="96dp" android:layout_height="96dp"
            android:background="@drawable/bg_avatar_green" />
        <TextView android:id="@+id/profile_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:text="Omar K." android:textSize="24sp"
            android:textStyle="bold" android:fontFamily="serif" android:textColor="@color/primary" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Member since Ramadan 1445" android:textColor="@color/on_surface_variant"
            android:textSize="13sp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:orientation="horizontal" android:baselineAligned="false">
            <com.google.android.material.card.MaterialCardView style="@style/Widget.Noor.Card"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:layout_marginEnd="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="584" android:textSize="26sp" android:textStyle="bold"
                        android:fontFamily="serif" android:textColor="@color/primary" />
                    <TextView style="@style/Text.Overline" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="THIS WEEK" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView style="@style/Widget.Noor.Card"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:layout_marginStart="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="12,480" android:textSize="26sp" android:textStyle="bold"
                        android:fontFamily="serif" android:textColor="@color/primary" />
                    <TextView style="@style/Text.Overline" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="LIFETIME" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_logout"
            style="@style/Widget.Noor.Button.Outlined"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="Log Out" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
