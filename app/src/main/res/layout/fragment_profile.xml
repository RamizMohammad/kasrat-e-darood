<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_horizontal"
        android:paddingHorizontal="24dp" android:paddingTop="40dp" android:paddingBottom="32dp">

        <View android:layout_width="96dp" android:layout_height="96dp"
            android:background="@drawable/bg_avatar_green" />
        <TextView android:id="@+id/profile_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:text="Member" android:textSize="24sp"
            android:textStyle="bold" android:fontFamily="serif" android:textColor="@color/primary" />
        <TextView android:id="@+id/profile_streak" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="@color/on_surface_variant" android:textSize="13sp" />

        <!-- Submission stats -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:orientation="horizontal" android:baselineAligned="false">
            <com.google.android.material.card.MaterialCardView style="@style/Widget.Noor.Card"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:layout_marginEnd="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/stat_week" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textSize="24sp" android:textStyle="bold"
                        android:fontFamily="serif" android:textColor="@color/primary" />
                    <TextView style="@style/Text.Overline" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="THIS WEEK" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView style="@style/Widget.Noor.Card"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/stat_today" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textSize="24sp" android:textStyle="bold"
                        android:fontFamily="serif" android:textColor="@color/primary" />
                    <TextView style="@style/Text.Overline" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="TODAY" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView style="@style/Widget.Noor.Card"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:layout_marginStart="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/stat_lifetime" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textSize="24sp" android:textStyle="bold"
                        android:fontFamily="serif" android:textColor="@color/primary" />
                    <TextView style="@style/Text.Overline" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="LIFETIME" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Menu -->
        <com.google.android.material.card.MaterialCardView style="@style/Widget.Noor.Card"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" app:contentPadding="4dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout android:id="@+id/row_settings" style="@style/Noor.ProfileRow">
                    <ImageView style="@style/Noor.ProfileRowIcon" android:src="@drawable/ic_qibla" />
                    <TextView style="@style/Noor.ProfileRowLabel" android:text="@string/settings" />
                    <ImageView style="@style/Noor.ProfileRowChevron" android:src="@drawable/ic_chevron_right" />
                </LinearLayout>

                <LinearLayout android:id="@+id/row_submissions" style="@style/Noor.ProfileRow">
                    <ImageView style="@style/Noor.ProfileRowIcon" android:src="@drawable/ic_stats" />
                    <TextView style="@style/Noor.ProfileRowLabel" android:text="@string/your_submissions" />
                    <ImageView style="@style/Noor.ProfileRowChevron" android:src="@drawable/ic_chevron_right" />
                </LinearLayout>

                <LinearLayout android:id="@+id/row_developer" style="@style/Noor.ProfileRow">
                    <ImageView style="@style/Noor.ProfileRowIcon" android:src="@drawable/ic_sparkle" />
                    <TextView style="@style/Noor.ProfileRowLabel" android:text="@string/developer_info" />
                    <ImageView style="@style/Noor.ProfileRowChevron" android:src="@drawable/ic_chevron_right" />
                </LinearLayout>

                <LinearLayout android:id="@+id/row_logout" style="@style/Noor.ProfileRow">
                    <ImageView style="@style/Noor.ProfileRowIcon" android:src="@drawable/ic_lock" app:tint="@color/error" />
                    <TextView style="@style/Noor.ProfileRowLabel" android:text="@string/log_out" android:textColor="@color/error" />
                    <ImageView style="@style/Noor.ProfileRowChevron" android:src="@drawable/ic_chevron_right" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
