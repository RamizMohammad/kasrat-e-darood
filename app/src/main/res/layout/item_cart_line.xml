<?xml version="1.0" encoding="utf-8"?>
<!-- Review line (Stitch review_log_teal): name (title-md) over Arabic (arabic-md, warm grey),
     ivory stepper on the right. Rows are split by hairlines (see sheet_cart). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/line_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.K.TitleMd"
            android:textColor="@color/text_primary"
            tools:text="Darood-e-Ibrahimi" />

        <TextView
            android:id="@+id/line_arabic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.K.ArabicMd"
            android:textColor="@color/text_muted" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:background="@drawable/bg_k_stepper"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp">

        <ImageView
            android:id="@+id/line_minus"
            style="@style/K.StepMinus"
            android:contentDescription="@string/cart_remove" />

        <in.mohammad.ramiz.islamic.kasrat_e_darrod.ui.components.CountRollTextView
            android:id="@+id/line_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:gravity="center"
            android:minWidth="28dp"
            android:textAppearance="@style/TextAppearance.K.SerifLabel"
            android:textColor="@color/text_primary"
            tools:text="100" />

        <ImageView
            android:id="@+id/line_plus"
            style="@style/K.StepPlus"
            android:contentDescription="@string/quick_add" />
    </LinearLayout>

    <!-- Kept for CartLineAdapter; the stepper's minus removes at zero (no X in Stitch). -->
    <View
        android:id="@+id/line_remove"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</LinearLayout>
