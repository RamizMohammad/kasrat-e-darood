<?xml version="1.0" encoding="utf-8"?>
<!--
    Phase 7c · Settings (Stitch settings_teal): back, "Settings", then cards: Account ·
    Recitation · Reminders · Appearance · Prayer times · Notifications · Privacy · About, and a
    centred "Sign out". Prayer times and Notifications aren't in Stitch; they keep the app's
    existing choices. Driven by ui/settings/SettingsActivity.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:orientation="vertical">

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/settings_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="invisible"
        app:indicatorColor="@color/amber"
        app:trackColor="@color/transparent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/settings_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/settings_column"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/k_page_margin"
            android:paddingTop="16dp"
            android:paddingBottom="40dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_back"
                style="@style/Widget.Kasrat.IconButton.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/action_back"
                app:icon="@drawable/ic_ph_arrow_left"
                app:iconTint="@color/text_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="24dp"
                android:accessibilityHeading="true"
                android:text="@string/me_k_settings"
                android:textAppearance="@style/TextAppearance.K.HeadlineLgMobile"
                android:textColor="@color/text_primary" />

            <LinearLayout
                android:id="@+id/settings_error"
                style="@style/K.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/set_k_load_error"
                    android:textAppearance="@style/TextAppearance.K.BodySm"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/settings_retry"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_k_ivory_pill"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="@string/action_try_again"
                    android:textAppearance="@style/TextAppearance.K.LabelSm"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <TextView
                style="@style/K.SectionEyebrow"
                android:layout_marginTop="0dp"
                android:text="@string/set_k_account" />

            <LinearLayout
                android:id="@+id/settings_account"
                style="@style/K.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/k_divider"
                android:orientation="vertical"
                android:showDividers="middle" />

            <TextView
                style="@style/K.SectionEyebrow"
                android:layout_marginTop="24dp"
                android:text="@string/set_k_recitation" />

            <LinearLayout
                android:id="@+id/settings_recitation"
                style="@style/K.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/k_divider"
                android:orientation="vertical"
                android:showDividers="middle" />

            <TextView
                style="@style/K.SectionEyebrow"
                android:layout_marginTop="24dp"
                android:text="@string/set_k_reminders" />

            <LinearLayout
                android:id="@+id/settings_reminders"
                style="@style/K.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/k_divider"
                android:orientation="vertical"
                android:showDividers="middle" />

            <TextView
                style="@style/K.SectionEyebrow"
                android:layout_marginTop="24dp"
                android:text="@string/set_k_appearance" />

            <LinearLayout
                android:id="@+id/settings_appearance"
                style="@style/K.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/k_divider"
                android:orientation="vertical"
                android:showDividers="middle" />

            <TextView
                style="@style/K.SectionEyebrow"
                android:layout_marginTop="24dp"
                android:text="@string/set_k_prayer" />

            <LinearLayout
                android:id="@+id/settings_prayer"
                style="@style/K.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/k_divider"
                android:orientation="vertical"
                android:showDividers="middle" />

            <TextView
                style="@style/K.SectionEyebrow"
                android:layout_marginTop="24dp"
                android:text="@string/set_k_notifications" />

            <LinearLayout
                android:id="@+id/settings_notify"
                style="@style/K.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/k_divider"
                android:orientation="vertical"
                android:showDividers="middle" />

            <TextView
                style="@style/K.SectionEyebrow"
                android:layout_marginTop="24dp"
                android:text="@string/set_k_privacy" />

            <LinearLayout
                android:id="@+id/settings_privacy"
                style="@style/K.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/k_divider"
                android:orientation="vertical"
                android:showDividers="middle" />

            <TextView
                style="@style/K.SectionEyebrow"
                android:layout_marginTop="24dp"
                android:text="@string/set_k_about" />

            <LinearLayout
                android:id="@+id/settings_about"
                style="@style/K.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/k_divider"
                android:orientation="vertical"
                android:showDividers="middle" />

            <TextView
                android:id="@+id/settings_signout"
                style="@style/K.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:minHeight="56dp"
                android:padding="16dp"
                android:text="@string/set_k_sign_out"
                android:textAppearance="@style/TextAppearance.K.LabelLg"
                android:textColor="@color/k_muted_red" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
