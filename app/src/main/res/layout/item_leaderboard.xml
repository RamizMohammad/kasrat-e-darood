<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/surface_container_lowest"
    app:contentPadding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/lb_rank" android:layout_width="24dp" android:layout_height="wrap_content"
            android:text="4" android:textColor="@color/outline" android:textStyle="bold" android:textSize="16sp" />
        <View android:id="@+id/lb_avatar" android:layout_width="40dp" android:layout_height="40dp"
            android:layout_marginStart="6dp" android:background="@drawable/bg_avatar_green" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView android:id="@+id/lb_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Fatima R." android:textColor="@color/on_surface" android:textSize="15sp"
                android:fontFamily="sans-serif-medium" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:layout_width="12dp" android:layout_height="12dp"
                    android:src="@drawable/ic_fire" app:tint="@color/secondary" />
                <TextView android:id="@+id/lb_streak" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="4dp" android:text="7 days streak"
                    android:textColor="@color/on_surface_variant" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="end">
            <TextView android:id="@+id/lb_total" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="315" android:textColor="@color/primary" android:textStyle="bold"
                android:fontFamily="serif" android:textSize="18sp" />
            <TextView style="@style/Text.Overline" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="AYAHS" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
