<?xml version="1.0" encoding="utf-8"?>
<!-- Settings → Account (Stitch): 44dp avatar, name, email, caret. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="20dp"
    android:paddingVertical="16dp">

    <in.mohammad.ramiz.islamic.kasrat_e_darrod.ui.components.AuraAvatarView
        android:id="@+id/acc_avatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/acc_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.K.TitleMd"
            android:textColor="@color/text_primary"
            android:textDirection="firstStrong"
            tools:text="Mohammad Ramiz" />

        <TextView
            android:id="@+id/acc_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.K.BodySm"
            android:textColor="@color/text_muted"
            android:textDirection="ltr"
            tools:text="ramiz@example.com" />
    </LinearLayout>

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_ph_caret_right"
        app:tint="@color/text_muted" />
</LinearLayout>
