<?xml version="1.0" encoding="utf-8"?>
<!-- Old name "fraunces" kept for code (R.font.fraunces): now Playfair Display (variable, wght 400–900; OFL, docs/font-licenses): headlines, display and
     every count. Bold for titles and numbers, regular italic for quotes and translations. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font android:font="@font/playfair_var" android:fontStyle="normal" android:fontWeight="400" android:fontVariationSettings="'wght' 400" />
    <font android:font="@font/playfair_var" android:fontStyle="normal" android:fontWeight="500" android:fontVariationSettings="'wght' 500" />
    <font android:font="@font/playfair_var" android:fontStyle="normal" android:fontWeight="600" android:fontVariationSettings="'wght' 600" />
    <font android:font="@font/playfair_var" android:fontStyle="normal" android:fontWeight="700" android:fontVariationSettings="'wght' 700" />
    <font android:font="@font/playfair_var" android:fontStyle="normal" android:fontWeight="800" android:fontVariationSettings="'wght' 800" />
    <font android:font="@font/playfair_var" android:fontStyle="normal" android:fontWeight="900" android:fontVariationSettings="'wght' 900" />
    <font android:font="@font/playfair_var_italic" android:fontStyle="italic" android:fontWeight="400" android:fontVariationSettings="'wght' 400" />
    <font android:font="@font/playfair_var_italic" android:fontStyle="italic" android:fontWeight="500" android:fontVariationSettings="'wght' 500" />
    <font android:font="@font/playfair_var_italic" android:fontStyle="italic" android:fontWeight="600" android:fontVariationSettings="'wght' 600" />
    <font android:font="@font/playfair_var_italic" android:fontStyle="italic" android:fontWeight="700" android:fontVariationSettings="'wght' 700" />
</font-family>
