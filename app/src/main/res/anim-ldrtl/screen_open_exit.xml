<?xml version="1.0" encoding="utf-8"?>
<!-- The screen underneath drifts a quarter back and dims (parallax). -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="320"
    android:interpolator="@interpolator/k_screen"
    android:zAdjustment="bottom">
    <translate android:fromXDelta="0" android:toXDelta="25%" />
    <alpha android:fromAlpha="1" android:toAlpha="0.7" />
</set>
