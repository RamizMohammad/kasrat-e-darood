<?xml version="1.0" encoding="utf-8"?>
<!-- Going back: the screen underneath slides back into place and brightens. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="300"
    android:interpolator="@interpolator/k_screen"
    android:zAdjustment="bottom">
    <translate android:fromXDelta="25%" android:toXDelta="0" />
    <alpha android:fromAlpha="0.7" android:toAlpha="1" />
</set>
