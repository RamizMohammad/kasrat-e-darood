<?xml version="1.0" encoding="utf-8"?>
<!-- Dark theme copy (Phase D): teal → gold, light fills → night surfaces. -->
<!-- Join code box (Stitch join_circle_enter_code_teal): white, deep-teal/45 hairline, 20dp;
     the next box to fill = full deep teal; error = muted red. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_lowest" />
            <stroke android:width="1dp" android:color="@color/brick" />
            <corners android:radius="@dimen/k_radius_md" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_lowest" />
            <stroke android:width="1dp" android:color="@color/amber" />
            <corners android:radius="@dimen/k_radius_md" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_lowest" />
            <stroke android:width="1dp" android:color="#73C9A24B" />
            <corners android:radius="@dimen/k_radius_md" />
        </shape>
    </item>
</selector>
