<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup rules for Android 11 and lower (fullBackupContent).
   The sign-in tokens in noor_auth.xml must never leave the device: restored
   onto another phone they would be a working session for this account.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="noor_auth.xml" />
</full-backup-content>
