<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device-transfer rules for Android 12+.
   Sign-in tokens (noor_auth.xml) are excluded from cloud backup and from
   device-to-device transfer; the user simply signs in again on a new phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="noor_auth.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="noor_auth.xml" />
    </device-transfer>
</data-extraction-rules>
