<?xml version="1.0" encoding="utf-8"?>
<!-- Moving to a different part of the app (sign-in → Home): a quick fade-through. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/k_surface_enter"
    android:zAdjustment="top">
    <alpha android:fromAlpha="0" android:toAlpha="1" android:startOffset="90" android:duration="210" />
    <scale android:fromXScale="0.96" android:toXScale="1" android:fromYScale="0.96" android:toYScale="1"
        android:pivotX="50%" android:pivotY="50%" android:startOffset="90" android:duration="210" />
</set>
