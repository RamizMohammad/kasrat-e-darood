<?xml version="1.0" encoding="utf-8"?>
<!-- Choice row in a sheet (Stitch): white, hairline, 20dp. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/amber_tint">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_lowest" />
            <stroke android:width="1dp" android:color="@color/hairline" />
            <corners android:radius="@dimen/k_radius_md" />
        </shape>
    </item>
</ripple>
