<?xml version="1.0" encoding="utf-8"?>
<!-- Announcement editor (rounded-md bg-warm-ivory border-hairline; deep teal when focused). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ink" />
            <stroke android:width="@dimen/hairline" android:color="@color/amber" />
            <corners android:radius="@dimen/k_radius_md" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ink" />
            <stroke android:width="@dimen/hairline" android:color="@color/hairline" />
            <corners android:radius="@dimen/k_radius_md" />
        </shape>
    </item>
</selector>
