<?xml version="1.0" encoding="utf-8"?>
<!-- Ivory strip with a 1dp hairline at the bottom (circle tab row). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="rectangle"><solid android:color="@color/ink" /></shape></item>
    <item android:gravity="bottom|fill_horizontal" android:height="1dp">
        <shape android:shape="rectangle"><solid android:color="@color/hairline" /></shape>
    </item>
</layer-list>
