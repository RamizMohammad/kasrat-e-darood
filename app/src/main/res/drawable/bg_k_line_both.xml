<?xml version="1.0" encoding="utf-8"?>
<!-- First row of a notifications group: hairlines top and bottom (border-y). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="top|fill_horizontal" android:height="1dp">
        <shape android:shape="rectangle"><solid android:color="@color/hairline" /></shape>
    </item>
    <item android:gravity="bottom|fill_horizontal" android:height="1dp">
        <shape android:shape="rectangle"><solid android:color="@color/hairline" /></shape>
    </item>
</layer-list>
