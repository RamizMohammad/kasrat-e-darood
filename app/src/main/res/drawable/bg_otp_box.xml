<?xml version="1.0" encoding="utf-8"?>
<!-- Stitch "Invite Code Boxes": soft ivory, 1px hairline, 12dp. Next digit = teal; error = muted red. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ink" />
            <stroke android:width="@dimen/hairline" android:color="@color/amber" />
            <corners android:radius="@dimen/k_radius_sm" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ink" />
            <stroke android:width="@dimen/hairline" android:color="@color/brick" />
            <corners android:radius="@dimen/k_radius_sm" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ink" />
            <stroke android:width="@dimen/hairline" android:color="@color/hairline" />
            <corners android:radius="@dimen/k_radius_sm" />
        </shape>
    </item>
</selector>
