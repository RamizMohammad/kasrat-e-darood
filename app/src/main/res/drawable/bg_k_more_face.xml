<?xml version="1.0" encoding="utf-8"?>
<!-- "+10" face: warm ivory, hairline, 2dp white ring. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="oval"><solid android:color="@color/surface_lowest" /></shape></item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="@color/ink" />
            <stroke android:width="1dp" android:color="@color/hairline" />
        </shape>
    </item>
</layer-list>
