<?xml version="1.0" encoding="utf-8"?>
<!-- Full-bleed list row (notifications): a 1dp hairline at the bottom, ripple on top. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="bottom|fill_horizontal" android:height="1dp">
        <shape android:shape="rectangle"><solid android:color="@color/hairline" /></shape>
    </item>
</layer-list>
