    <!-- ── Part 2 · old names → kit ─────────────────────────────────────── -->

    <!-- display-lg-mobile -->
    <style name="TextAppearance.Kasrat.Display" parent="TextAppearance.K.DisplayLgMobile" />
    <!-- headline-lg-mobile -->
    <style name="TextAppearance.Kasrat.Headline" parent="TextAppearance.K.HeadlineLgMobile" />
    <!-- headline-sm -->
    <style name="TextAppearance.Kasrat.HeadlineSmall" parent="TextAppearance.K.HeadlineSm" />
    <!-- title-md (sans) -->
    <style name="TextAppearance.Kasrat.Title" parent="TextAppearance.K.TitleMd" />
    <!-- Translations / meanings under Arabic: Fraunces italic body-md. -->
    <style name="TextAppearance.Kasrat.Recitation" parent="TextAppearance.K.SerifItalic" />
    <!-- Recitation card title: "Darood-e-Ibrahimi" (title-md). -->
    <style name="TextAppearance.Kasrat.Recitation.Card" parent="TextAppearance.K.TitleMd" />
    <style name="TextAppearance.Kasrat.Quote" parent="TextAppearance.K.SerifItalic" />
    <!-- body-md -->
    <style name="TextAppearance.Kasrat.Body" parent="TextAppearance.K.BodyMd" />
    <style name="TextAppearance.Kasrat.BodyMedium" parent="TextAppearance.K.BodyMd" />
    <!-- label-lg -->
    <style name="TextAppearance.Kasrat.Label" parent="TextAppearance.K.LabelLg" />
    <style name="TextAppearance.Kasrat.Button" parent="TextAppearance.K.LabelLg" />
    <!-- body-sm (metadata: "5:54 PM · After Maghrib") -->
    <style name="TextAppearance.Kasrat.Meta" parent="TextAppearance.K.BodySm" />
    <!-- label-sm (tags, captions) -->
    <style name="TextAppearance.Kasrat.MetaSmall" parent="TextAppearance.K.LabelSm" />
    <!-- eyebrow: "WEEK 47 · 15–21 NOV" -->
    <style name="TextAppearance.Kasrat.Eyebrow" parent="TextAppearance.K.Eyebrow" />
    <style name="TextAppearance.Kasrat.Alias" parent="TextAppearance.K.LabelLg" />
    <!-- Counts: Fraunces, tabular figures. Log rows / tiles = headline-sm. -->
    <style name="TextAppearance.Kasrat.Count" parent="TextAppearance.K.HeadlineSm" />
    <!-- Tasbih count: display-lg. -->
    <style name="TextAppearance.Kasrat.Count.Huge" parent="TextAppearance.K.DisplayLg" />
    <!-- Big totals: "84,250" (headline-lg-mobile). -->
    <style name="TextAppearance.Kasrat.Count.Large" parent="TextAppearance.K.HeadlineLgMobile">
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <!-- Rank numbers, stepper and chip numbers: Fraunces title-md. -->
    <style name="TextAppearance.Kasrat.Count.Small" parent="TextAppearance.K.SerifTitle" />
    <!-- Arabic: arabic-md / arabic-lg -->
    <style name="TextAppearance.Kasrat.Arabic" parent="TextAppearance.K.ArabicMd" />
    <style name="TextAppearance.Kasrat.Arabic.Large" parent="TextAppearance.K.ArabicLg" />

</resources>
