<?xml version="1.0" encoding="utf-8"?>
<!--
    Kasrat-e-Darood type scale, from the Stitch "Quiet Luxury" kit:
      Playfair   display / headline / every count — Bold for titles and numbers,
                 regular italic for quotes and translations (lining figures; no tabular)
      Jakarta    titles, body, labels, eyebrows (Plus Jakarta Sans)
      Amiri      Arabic
    Letter spacing is px ÷ size (Android uses em). Fraunces styles set their
    optical size ('opsz') to the text size, as the browser does. (Phase F: Fraunces → Playfair
    Display, and a bolder ladder: titles 700, labels 700, eyebrows 700 tracked, body 400.)

    Part 1 · the kit by its own names (TextAppearance.K.*), for new layouts.
    Part 2 · the old names, re-pointed at the closest kit style, so every
             existing screen picks the new look up unchanged.
-->
<resources>

    <!-- ── Part 1 · Stitch kit ─────────────────────────────────────────── -->
    <style name="TextAppearance.K.DisplayLg" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:fontFamily">@font/playfair</item>
        <item name="fontFamily">@font/playfair</item>
        <item name="android:textSize">48sp</item>
        <item name="android:lineHeight">54sp</item>
        <item name="lineHeight">54sp</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:fontVariationSettings">"'wght' 700"</item>
        <item name="android:letterSpacing">-0.015</item>
        <item name="android:fontFeatureSettings">lnum</item>
    </style>
    <style name="TextAppearance.K.DisplayLgMobile" parent="TextAppearance.Material3.DisplaySmall">
