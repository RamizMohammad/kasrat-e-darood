# Copy this file to secrets.properties (same folder) and fill it in.
# secrets.properties is git-ignored; this example is safe to commit.
# Any key can also be set as an environment variable (for CI).

# Servers (trailing "/" optional)
API_BASE_URL=https://your-api.example.com/
ALADHAN_BASE_URL=https://api.aladhan.com/

# Release signing (optional). Path is relative to the project root.
#RELEASE_STORE_FILE=keystore/kasrat-release.jks
#RELEASE_STORE_PASSWORD=
#RELEASE_KEY_ALIAS=
#RELEASE_KEY_PASSWORD=

# TLS certificate pins for the API host (optional). Default = Let's Encrypt
# roots ISRG X1 + X2. Set to "off" only while debugging a different CA.
#API_CERT_PINS=sha256/C5+lpZ7tcVwmwQIMcRtPbsQtWLABXhQzejna0wHFr8M=,sha256/diGVwiVYbubAI3RW4hB9xU8e/CH2GnkuvVFZE8zmgzI=

# SHA-256 of your release signing certificate, "AA:BB:CC:..." (optional).
# Get it with: keytool -list -v -keystore keystore/kasrat-release.jks
# (the "SHA256:" line). With Play App Signing use the App signing key from
# Play Console → Setup → App signing. Re-signed (modded) copies won't run.
#RELEASE_CERT_SHA256=
